Proceso Area_Triangulo_Descriptivo
    Definir baseTriangulo, alturaTriangulo, areaTriangulo Como Real
	
    Escribir "Digite la base del triangulo:"
    Leer baseTriangulo
	
    Escribir "Digite la altura del triangulo:"
    Leer alturaTriangulo
	
    areaTriangulo <- (baseTriangulo * alturaTriangulo) / 2
	
    Escribir "El area del triangulo es: ", areaTriangulo
FinProceso
